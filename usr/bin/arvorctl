#!/bin/bash
# /usr/bin/arvorctl
# Arvor Linux Atomic System Control & Snapshot Diagnostics

set -e

# Color definitions
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_GRAY="\033[38;2;148;163;184m"

get_root_dev() {
    local dev
    dev=$(findmnt -n -o SOURCE / 2>/dev/null | sed 's/\[.*\]//')
    echo "$dev"
}

get_vg_name() {
    local dev="$1"
    if [ -n "$dev" ] && lvs "$dev" >/dev/null 2>&1; then
        lvs --noheadings -o vg_name "$dev" 2>/dev/null | tr -d ' '
    fi
}

get_lv_name() {
    local dev="$1"
    if [ -n "$dev" ] && lvs "$dev" >/dev/null 2>&1; then
        lvs --noheadings -o lv_name "$dev" 2>/dev/null | tr -d ' '
    fi
}

cmd_status() {
    echo -e "${C_CYAN}${C_BOLD}=== Arvor Linux Atomic System Status ===${C_RESET}\n"

    local root_dev
    root_dev=$(get_root_dev)
    local vg_name
    vg_name=$(get_vg_name "$root_dev")
    local lv_name
    lv_name=$(get_lv_name "$root_dev")

    echo -e "${C_BOLD}Root Device:${C_RESET}       ${root_dev:-Unknown}"
    echo -e "${C_BOLD}Volume Group:${C_RESET}      ${vg_name:-N/A}"
    echo -e "${C_BOLD}Root Volume:${C_RESET}       ${lv_name:-N/A}"

    # 1. Boot Health Check
    echo -e "\n${C_BOLD}[Boot Health Verification]${C_RESET}"
    local tag_status="${C_RED}Missing (Dirty / Unverified)${C_RESET}"
    if [ -n "$root_dev" ] && lvs "$root_dev" >/dev/null 2>&1; then
        local tags
        tags=$(lvs --noheadings -o lv_tags "$root_dev" 2>/dev/null | tr -d ' ')
        if echo "$tags" | grep -q "boot_ok"; then
            tag_status="${C_GREEN}Active (boot_ok verified)${C_RESET}"
        fi
    fi
    echo -e "  LVM Metadata Tag:      $tag_status"

    local run_status="${C_RED}Missing${C_RESET}"
    [ -f /run/bootisok ] && run_status="${C_GREEN}Present (/run/bootisok)${C_RESET}"
    echo -e "  Runtime Flag:          $run_status"

    local disk_status="${C_RED}Missing${C_RESET}"
    [ -f /var/lib/arvor/bootisok ] && disk_status="${C_GREEN}Present (/var/lib/arvor/bootisok)${C_RESET}"
    echo -e "  Persistent Disk Flag:  $disk_status"

    # 2. Active Root
    echo -e "\n${C_BOLD}[Active Root Volume]${C_RESET}"
    if [ -n "$vg_name" ] && [ -n "$lv_name" ]; then
        echo -e "  ${C_CYAN}● Running Root:${C_RESET}  /dev/$vg_name/$lv_name"
    else
        echo -e "  ${C_RED}Unable to identify running root volume.${C_RESET}"
    fi

    # 3. Snapshots
    echo -e "\n${C_BOLD}[Snapshots of Root]${C_RESET}"
    if [ -n "$vg_name" ]; then
        local snaps
        snaps=$(lvs --noheadings -o lv_name,origin,data_percent,lv_time "$vg_name" 2>/dev/null \
                | awk -v root="$lv_name" '$2 == root {print $1"|"$3"|"$4}')
        if [ -n "$snaps" ]; then
            while IFS='|' read -r sname delta stime; do
                sname=$(echo "$sname" | xargs)
                delta=$(echo "$delta" | xargs)
                stime=$(echo "$stime" | xargs)
                echo -e "  ${C_GREEN}●${C_RESET} ${sname}  ${C_GRAY}(Delta: ${delta:-0}%, Created: ${stime:-unknown})${C_RESET}"
            done <<< "$snaps"
        else
            echo -e "  ${C_GRAY}No snapshots found for root volume.${C_RESET}"
        fi
    else
        echo -e "  ${C_RED}Unable to inspect LVM volume group.${C_RESET}"
    fi
    echo ""
}

cmd_snapshot() {
    local name="$1"
    if [ -z "$name" ]; then
        name="snap_$(date +%Y%m%d_%H%M%S)"
    fi

    if [ "$EUID" -ne 0 ]; then
        echo -e "${C_RED}Error:${C_RESET} Root privileges required to create snapshots."
        exit 1
    fi

    local root_dev
    root_dev=$(get_root_dev)
    local vg_name
    vg_name=$(get_vg_name "$root_dev")
    local lv_name
    lv_name=$(get_lv_name "$root_dev")

    if [ -z "$vg_name" ] || [ -z "$lv_name" ]; then
        echo -e "${C_RED}Error:${C_RESET} Could not identify root LVM volume."
        exit 1
    fi

    echo -e "${C_CYAN}Creating thin LVM snapshot '${name}' from /dev/$vg_name/$lv_name...${C_RESET}"
    if lvcreate -s --name "$name" -k n "/dev/$vg_name/$lv_name"; then
        echo -e "${C_GREEN}✔ Snapshot '${name}' created successfully.${C_RESET}"
    else
        echo -e "${C_RED}Failed to create snapshot.${C_RESET}"
        exit 1
    fi
}

cmd_rollback() {
    local target="$1"

    if [ -z "$target" ]; then
        echo -e "${C_RED}Error:${C_RESET} No snapshot specified."
        echo -e "Usage: arvorctl rollback <snapshot_name>"
        exit 1
    fi

    if [ "$EUID" -ne 0 ]; then
        echo -e "${C_RED}Error:${C_RESET} Root privileges required to perform rollbacks."
        exit 1
    fi

    local root_dev
    root_dev=$(get_root_dev)
    local vg_name
    vg_name=$(get_vg_name "$root_dev")

    if ! lvs "/dev/$vg_name/$target" >/dev/null 2>&1; then
        echo -e "${C_RED}Error:${C_RESET} Snapshot '/dev/$vg_name/$target' does not exist."
        exit 1
    fi

    echo -e "${C_YELLOW}${C_BOLD}WARNING:${C_RESET} You are about to roll back root filesystem to snapshot '${target}'."
    echo -e "The merge operation will occur and take effect immediately or upon next boot.\n"
    read -rp "Are you sure you want to proceed? [y/N]: " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        echo "Aborted."
        exit 0
    fi

    echo -e "${C_CYAN}Merging snapshot /dev/$vg_name/$target into root...${C_RESET}"
    if lvconvert --merge "/dev/$vg_name/$target"; then
        echo -e "${C_GREEN}✔ Rollback scheduled successfully! Please reboot your system to finalize the rollback.${C_RESET}"
    else
        echo -e "${C_RED}Failed to merge snapshot.${C_RESET}"
        exit 1
    fi
}

cmd_diff() {
    local target="$1"

    if [ -z "$target" ]; then
        echo -e "${C_RED}Error:${C_RESET} No snapshot specified."
        echo -e "Usage: arvorctl diff <snapshot_name>"
        exit 1
    fi

    if [ "$EUID" -ne 0 ]; then
        echo -e "${C_RED}Error:${C_RESET} Root privileges required to inspect snapshots."
        exit 1
    fi

    local root_dev
    root_dev=$(get_root_dev)
    local vg_name
    vg_name=$(get_vg_name "$root_dev")

    if ! lvs "/dev/$vg_name/$target" >/dev/null 2>&1; then
        echo -e "${C_RED}Error:${C_RESET} Snapshot '/dev/$vg_name/$target' does not exist."
        exit 1
    fi

    local tmp_mnt
    tmp_mnt=$(mktemp -d /tmp/.arvor_diff_XXXXXX)

    cleanup_diff() {
        umount -l "$tmp_mnt" >/dev/null 2>&1 || true
        rmdir "$tmp_mnt" >/dev/null 2>&1 || true
    }
    trap cleanup_diff EXIT INT TERM

    echo -e "${C_CYAN}Mounting snapshot '/dev/$vg_name/$target' (read-only)...${C_RESET}"
    if ! mount -o ro,nouuid "/dev/$vg_name/$target" "$tmp_mnt" 2>/dev/null && ! mount -o ro "/dev/$vg_name/$target" "$tmp_mnt" 2>/dev/null; then
        echo -e "${C_RED}Failed to mount snapshot.${C_RESET}"
        exit 1
    fi

    echo -e "${C_BOLD}Comparing live system vs snapshot '${target}' (/etc, /usr/bin, /usr/lib, /var/lib)...${C_RESET}\n"

    local diff_dirs=("/etc" "/usr/bin" "/usr/lib" "/var/lib/dpkg")
    local count=0

    for d in "${diff_dirs[@]}"; do
        if [ ! -d "$d" ] || [ ! -d "$tmp_mnt$d" ]; then continue; fi

        while IFS= read -r f; do
            local rel="${f#/}"
            if [ ! -e "$tmp_mnt/$rel" ]; then
                echo -e "  ${C_GREEN}+ [ADDED]${C_RESET}    /$rel"
                ((count++)) || true
            elif [ ! -d "$f" ] && ! cmp -s "$f" "$tmp_mnt/$rel" 2>/dev/null; then
                echo -e "  ${C_YELLOW}~ [MODIFIED]${C_RESET} /$rel"
                ((count++)) || true
            fi
        done < <(find "$d" -maxdepth 3 -type f 2>/dev/null | head -n 200)

        while IFS= read -r f; do
            local rel="${f#$tmp_mnt/}"
            if [ ! -e "/$rel" ]; then
                echo -e "  ${C_RED}- [DELETED]${C_RESET}  /$rel"
                ((count++)) || true
            fi
        done < <(find "$tmp_mnt$d" -maxdepth 3 -type f 2>/dev/null | head -n 200)
    done

    echo ""
    if [ "$count" -eq 0 ]; then
        echo -e "${C_GREEN}✔ No file differences detected between live system and snapshot '${target}'.${C_RESET}"
    else
        echo -e "${C_BOLD}Total differences found:${C_RESET} $count"
    fi

    cleanup_diff
    trap - EXIT INT TERM
}

cmd_mark_ok() {
    if [ -x /usr/bin/arvor-boot-success ]; then
        /usr/bin/arvor-boot-success
        echo -e "${C_GREEN}✔ System marked as healthy.${C_RESET}"
    else
        echo -e "${C_RED}Error:${C_RESET} /usr/bin/arvor-boot-success not found."
        exit 1
    fi
}

show_help() {
    echo -e "${C_CYAN}${C_BOLD}arvorctl - Arvor Linux Atomic Management Tool${C_RESET}\n"
    echo -e "Usage: arvorctl [command] [options]\n"
    echo -e "Commands:"
    echo -e "  ${C_BOLD}status${C_RESET}                Display boot health, root volume, and snapshots"
    echo -e "  ${C_BOLD}snapshot [name]${C_RESET}       Create a new thin snapshot of root (auto-named if omitted)"
    echo -e "  ${C_BOLD}diff <name>${C_RESET}            Inspect file differences between live system and a snapshot"
    echo -e "  ${C_BOLD}rollback <name>${C_RESET}        Rollback root partition to the specified snapshot"
    echo -e "  ${C_BOLD}mark-ok${C_RESET}               Manually validate and mark current boot state as healthy"
    echo -e "  ${C_BOLD}help${C_RESET}                  Show this help message\n"
}

case "$1" in
    status)
        cmd_status
        ;;
    snapshot|snap)
        cmd_snapshot "$2"
        ;;
    diff)
        cmd_diff "$2"
        ;;
    rollback|revert)
        cmd_rollback "$2"
        ;;
    mark-ok|verify)
        cmd_mark_ok
        ;;
    -h|--help|help|"")
        show_help
        ;;
    *)
        echo -e "${C_RED}Unknown command: $1${C_RESET}"
        show_help
        exit 1
        ;;
esac
