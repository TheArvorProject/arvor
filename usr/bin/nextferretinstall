    def on_keymap_changed(self, keymap):
        self.conf["keymap"] = keymap
        if not SIMULATE:
            Sys.run(f"setxkbmap {keymap}", check=False)

    def create_desktop_page(self):
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setStyleSheet("QScrollArea{border:none;background:transparent;} QWidget#desktop_container{background:transparent;}")

        w = QWidget()
        w.setObjectName("desktop_container")
        l = QVBoxLayout(w)
        l.setContentsMargins(0, 0, 8, 0)
        l.addWidget(self.create_title("step_desktop"))
        card, cl = self._create_card()

        self.lbl_de = self._create_label("de")
        self.c_de = self._make_combo()
        for d in self.desktops: self.c_de.addItem(d[0], d[1])

        de_info_box = QFrame()
        de_info_box.setStyleSheet("background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px; margin-top: 10px;")
        de_info_layout = QVBoxLayout(de_info_box)

        self.lbl_de_desc = QLabel()
        self.lbl_de_desc.setStyleSheet("font-size: 13px; color: #475569; line-height: 1.4;")
        self.lbl_de_desc.setWordWrap(True)
        de_info_layout.addWidget(self.lbl_de_desc)

        self.de_descs_map = {
            "None (CLI)": "de_desc_cli",
            "XFCE": "de_desc_xfce",
            "GNOME": "de_desc_gnome",
            "KDE Plasma": "de_desc_kde",
            "Cinnamon": "de_desc_cinnamon",
            "MATE": "de_desc_mate",
            "LXQt": "de_desc_lxqt"
        }

        def update_de_desc(idx=0):
            name = self.c_de.currentText()
            desc_key = self.de_descs_map.get(name, "de_desc_cli")
            self.lbl_de_desc.setText(self.t(desc_key))

        self.update_de_desc = update_de_desc
        self.c_de.currentIndexChanged.connect(self.update_de_desc)
        self.update_de_desc(0)

        self.c_de.setCurrentIndex(next((i for i, d in enumerate(self.desktops) if d[0] == "XFCE"), 0))
        cl.addWidget(self.lbl_de)
        cl.addLayout(self._make_de_cards())
        cl.addWidget(de_info_box)

        self.lbl_apps_header = self._create_label("apps_header", "font-size: 14px; font-weight: 700; color: #1e293b; margin-top: 18px; margin-bottom: 6px;")
        cl.addWidget(self.lbl_apps_header)

        apps_grid = QGridLayout()
        apps_grid.setSpacing(12)

        self.chk_firefox = QCheckBox(self.t("app_firefox"))
        self.chk_firefox.setChecked(True)
        self.chk_chromium = QCheckBox(self.t("app_chromium"))
        self.chk_office = QCheckBox(self.t("app_office"))
        self.chk_vlc = QCheckBox(self.t("app_vlc"))

        apps_grid.addWidget(self.chk_firefox, 0, 0)
        apps_grid.addWidget(self.chk_chromium, 0, 1)
        apps_grid.addWidget(self.chk_office, 1, 0)
        apps_grid.addWidget(self.chk_vlc, 1, 1)
        cl.addLayout(apps_grid)

        self.lbl_drivers_header = self._create_label("drivers_header", "font-size: 14px; font-weight: 700; color: #1e293b; margin-top: 16px; margin-bottom: 6px;")
        cl.addWidget(self.lbl_drivers_header)

        drivers_grid = QGridLayout()
        drivers_grid.setSpacing(12)

        self.chk_nvidia = QCheckBox(self.t("drv_nvidia"))
        self.chk_firmware = QCheckBox(self.t("drv_firmware"))
        self.chk_firmware.setChecked(True)
        self.chk_mediatek = QCheckBox(self.t("drv_mediatek"))

        drivers_grid.addWidget(self.chk_nvidia, 0, 0)
        drivers_grid.addWidget(self.chk_firmware, 0, 1)
        drivers_grid.addWidget(self.chk_mediatek, 1, 0)
        cl.addLayout(drivers_grid)

        l.addWidget(card)
        l.addStretch()
        scroll.setWidget(w)
        return scroll

    def _make_de_cards(self):
        """Clickable cards that drive the (hidden) self.c_de combo, so the rest of the logic is unchanged."""
        grid = QGridLayout()
        grid.setSpacing(12)
        self.de_cards = []
        for i, (name, _pkgs) in enumerate(self.desktops):
            card = QFrame()
            card.setObjectName("de_card")
            card.setCursor(Qt.CursorShape.PointingHandCursor)
            card.setMinimumHeight(96)
            v = QVBoxLayout(card)
            v.setContentsMargins(10, 14, 10, 12)
            v.setSpacing(8)
            ic = QLabel()
            ic.setFixedSize(40, 40)
            ic.setAlignment(Qt.AlignmentFlag.AlignCenter)
            nm = QLabel(name)
            nm.setAlignment(Qt.AlignmentFlag.AlignCenter)
            nm.setStyleSheet("font-size:13px;font-weight:700;color:#1e293b;background:transparent;border:none;")
            v.addWidget(ic, 0, Qt.AlignmentFlag.AlignHCenter)
            v.addWidget(nm)
            card.mousePressEvent = lambda e, idx=i: self.c_de.setCurrentIndex(idx)
            self.de_cards.append((card, ic, "terminal" if i == 0 else "monitor"))
            grid.addWidget(card, i // 4, i % 4)
        self.c_de.currentIndexChanged.connect(self.refresh_de_cards)
        self.refresh_de_cards()
        return grid

    def refresh_de_cards(self, *_):
        cur = self.c_de.currentIndex()
        for i, (card, ic, icon_name) in enumerate(self.de_cards):
            if i == cur:
                card.setStyleSheet("QFrame#de_card{background:#f0f5ff;border:2px solid #4a78ff;border-radius:14px;}")
                ic.setStyleSheet("background:#4a78ff;border-radius:12px;border:none;")
                ic.setPixmap(svg_pixmap(icon_name, "#ffffff", 20, 2))
            else:
                card.setStyleSheet("QFrame#de_card{background:#ffffff;border:1.5px solid #d9e1eb;border-radius:14px;}"
                                   "QFrame#de_card:hover{border-color:#4a78ff;}")
                ic.setStyleSheet("background:#eaf0ff;border-radius:12px;border:none;")
                ic.setPixmap(svg_pixmap(icon_name, "#4a78ff", 20, 2))

    def create_zram_page(self):
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setStyleSheet("QScrollArea{border:none;background:transparent;} QWidget#zram_container{background:transparent;}")

        w = QWidget()
        w.setObjectName("zram_container")
        l = QVBoxLayout(w)
        l.setContentsMargins(0, 0, 8, 0)
        l.addWidget(self.create_title("zram_title", "zram_sub"))

        card_main, cl_main = self._create_card()

        self.lbl_swap = self._create_label("lbl_swap", "font-weight: 700; color: #1e293b; font-size: 15px; margin-bottom: 6px;")
        self.c_swap = self._make_combo()

        swap_info_box = QFrame()
        swap_info_box.setStyleSheet("background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; margin-top: 12px;")
        swap_info_layout = QVBoxLayout(swap_info_box)

        self.lbl_swap_desc = QLabel()
        self.lbl_swap_desc.setStyleSheet("font-size: 13px; color: #475569; line-height: 1.5;")
        self.lbl_swap_desc.setWordWrap(True)
        swap_info_layout.addWidget(self.lbl_swap_desc)

        self.swap_descs_map = {
            "zram": "swap_desc_zram",
            "file_auto": "swap_desc_file_auto",
            "file_2g": "swap_desc_file_2g",
            "file_4g": "swap_desc_file_4g",
            "file_8g": "swap_desc_file_8g",
            "none": "swap_desc_none"
        }

        def update_swap_desc(idx=0):
            mode = self.c_swap.currentData() if hasattr(self, 'c_swap') and self.c_swap.count() > 0 else "zram"
            desc_key = self.swap_descs_map.get(mode, "swap_desc_zram")
            self.lbl_swap_desc.setText(self.t(desc_key))

        self.update_swap_desc = update_swap_desc
        self.update_swap_options()
        self.c_swap.currentIndexChanged.connect(self.on_swap_mode_changed)
        self.update_swap_desc(0)

        cl_main.addWidget(self.lbl_swap)
        cl_main.addWidget(self.c_swap)
        cl_main.addWidget(swap_info_box)
        l.addWidget(card_main)
        l.addStretch()
        scroll.setWidget(w)
        return scroll

    def update_swap_options(self):
        if not hasattr(self, 'c_swap'): return
        current = self.c_swap.currentData() if self.c_swap.count() > 0 else (self.conf.get("swap_mode") or "zram")
        self.c_swap.blockSignals(True)
        self.c_swap.clear()
        self.c_swap.addItem(self.t("swap_zram"), "zram")
        self.c_swap.addItem(self.t("swap_auto"), "file_auto")
        self.c_swap.addItem(self.t("swap_file_2g"), "file_2g")
        self.c_swap.addItem(self.t("swap_file_4g"), "file_4g")
        self.c_swap.addItem(self.t("swap_file_8g"), "file_8g")
        self.c_swap.addItem(self.t("swap_none"), "none")
        for idx in range(self.c_swap.count()):
            if self.c_swap.itemData(idx) == current:
                self.c_swap.setCurrentIndex(idx)
                break
        self.c_swap.blockSignals(False)
        if hasattr(self, 'update_swap_desc'):
            self.update_swap_desc()

    def on_swap_mode_changed(self, idx):
        if hasattr(self, 'c_swap') and self.c_swap.count() > 0:
            self.conf["swap_mode"] = self.c_swap.currentData() or "zram"
            if hasattr(self, 'update_swap_desc'):
                self.update_swap_desc()

    def _make_password_field(self, enabled=True):
        wrapper = QFrame()
        wrapper.setFixedHeight(44)
        wrapper.setStyleSheet(
            "QFrame{background:#fff;border:1px solid #d9e1eb;border-radius:12px;}"
            "QFrame:focus-within{border:1.5px solid #4a78ff;background:#fbfcff;}"
        )
        h = QHBoxLayout(wrapper)
        h.setContentsMargins(14, 0, 10, 0)
        h.setSpacing(0)
        h.setAlignment(Qt.AlignmentFlag.AlignVCenter)
        field = QLineEdit()
        field.setEchoMode(QLineEdit.EchoMode.Password)
        field.setEnabled(enabled)
        field.setStyleSheet("border:none;background:transparent;padding:0;margin:0;min-height:38px;color:#243042;font-size:14px;")
        btn = QPushButton()
        btn.setIcon(svg_icon("eye", "#64748b", 18))
        btn.setIconSize(QSize(18, 18))
        btn.setFixedSize(34, 30)
        btn.setStyleSheet(
            "QPushButton{border:none;background:transparent;padding:0;margin:0;border-radius:8px;}"
            "QPushButton:hover{background:#eef3ff;}"
        )
        btn.setCursor(Qt.CursorShape.PointingHandCursor)
        def toggle():
            if field.echoMode() == QLineEdit.EchoMode.Password:
                field.setEchoMode(QLineEdit.EchoMode.Normal)
                btn.setIcon(svg_icon("eye-off", "#4a78ff", 18))
            else:
                field.setEchoMode(QLineEdit.EchoMode.Password)
                btn.setIcon(svg_icon("eye", "#64748b", 18))
        btn.clicked.connect(toggle)
        h.addWidget(field)
        h.addWidget(btn)
        return wrapper, field

    def _section_header(self, number, text_key):
        row = QWidget()
        h = QHBoxLayout(row)
        h.setContentsMargins(0, 8, 0, 4)
        h.setSpacing(10)
        badge = QLabel(str(number))
        badge.setFixedSize(24, 24)
        badge.setAlignment(Qt.AlignmentFlag.AlignCenter)
        badge.setStyleSheet("background:#4a78ff;color:#fff;border-radius:12px;font-size:12px;font-weight:700;")
        title = QLabel(self.t(text_key))
        title.setProperty("text_key", text_key)
        title.setStyleSheet("font-size:15px;font-weight:700;color:#1e293b;")
        h.addWidget(badge)
        h.addWidget(title)
        h.addStretch()
        return row

    def _make_fs_card(self, radio, title_text, desc_key, badge_key=None):
        card = QFrame()
        card.setObjectName("fs_card")
        card.setCursor(Qt.CursorShape.PointingHandCursor)
        v = QVBoxLayout(card)
        v.setContentsMargins(16, 14, 16, 14)
        v.setSpacing(6)

        top = QHBoxLayout()
        top.setSpacing(8)
        radio.setText(title_text)
        radio.setStyleSheet("QRadioButton{font-size:16px;font-weight:700;color:#1e293b;spacing:10px;background:transparent;}")
        top.addWidget(radio)
        if badge_key:
            badge = QLabel(self.t(badge_key))
            badge.setProperty("text_key", badge_key)
            badge.setStyleSheet("background:#dcfce7;color:#166534;border-radius:8px;padding:2px 8px;font-size:11px;font-weight:700;")
            top.addWidget(badge)
        top.addStretch()
        v.addLayout(top)

        desc = QLabel(self.t(desc_key))
        desc.setProperty("text_key", desc_key)
        desc.setWordWrap(True)
        desc.setStyleSheet("color:#475569;font-size:12px;background:transparent;")
        v.addWidget(desc)

        def refresh(checked=None):
            if radio.isChecked():
                card.setStyleSheet("QFrame#fs_card{background:#f0f5ff;border:2px solid #4a78ff;border-radius:14px;}")
            else:
                card.setStyleSheet("QFrame#fs_card{background:#ffffff;border:1.5px solid #d9e1eb;border-radius:14px;} QFrame#fs_card:hover{border-color:#4a78ff;}")
        radio.toggled.connect(refresh)
        card.mousePressEvent = lambda e: radio.setChecked(True)
        refresh()
        return card

