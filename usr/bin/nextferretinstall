    def detect_hardware_info(self):
        cpu = "Generic x86_64 processor"
        ram = "16 GB"
        if not SIMULATE:
            try:
                with open("/proc/cpuinfo", "r") as f:
                    for line in f:
                        if "model name" in line:
                            cpu = line.split(':')[1].strip()
                            break
            except Exception: pass
            try:
                with open("/proc/meminfo", "r") as f:
                    for line in f:
                        if "MemTotal" in line:
                            kb = int(line.split()[1])
                            ram = f"{round(kb / (1024 * 1024), 1)} GB"
                            break
            except Exception: pass
        return cpu, ram

    def _sum_section(self, color, title, rows):
        body = "".join(
            f"<tr><td width='200' style='color:#64748b;padding:3px 0;'>{esc(str(k))}</td>"
            f"<td style='color:#0f172a;font-weight:600;padding:3px 0;'>{esc(str(v))}</td></tr>"
            for k, v in rows
        )
        return (f"<p style='margin:18px 0 4px 0;color:{color};font-size:12px;font-weight:700;'>{esc(title.upper())}</p>"
                f"<table cellspacing='0' cellpadding='0' width='100%'>{body}</table>")

    def populate_summary(self):
        disp = self.conf.get('display_name', self.conf['user'])
        user_info = f"{disp} ({self.conf['user']})" if disp != self.conf['user'] else self.conf['user']
        extras = self.conf.get('extra_pkgs', '') or self.t("ui_sum_none")
        cpu, ram = self.detect_hardware_info()
        swap_label_key = next((lk for m, lk in self.swap_modes if m == self.conf.get("swap_mode", "zram")), "swap_zram")
        fs_type = "ext4" if self.conf.get("use_ext4") else "xfs"
        on_off = self.t("ui_sum_on") if self.conf['luks'] else self.t("ui_sum_off")

        sections = [
            ("#64748b", self.t("ui_sum_hw"), [(self.t("ui_sum_cpu"), cpu), (self.t("ui_sum_ram"), ram)]),
            ("#4a78ff", self.t("step_location"), [(self.t("locale"), self.sys_locale), (self.t("tz"), self.conf['timezone'])]),
            ("#6366f1", self.t("step_keyboard"), [(self.t("keymap"), self.conf['keymap'])]),
            ("#0ea5e9", self.t("step_desktop"), [(self.t("de"), self.conf['de_name']), (self.t("ui_sum_apps"), extras)]),
            ("#10b981", self.t("step_partitions"), [
                (self.t("ui_sum_disk"), self.c_disk.currentText() or self.conf['disk']),
                (self.t("ui_sum_fs"), fs_type.upper()),
                (self.t("ui_sum_enc"), on_off),
                (self.t("ui_sum_swap"), self.t(swap_label_key)),
            ]),
            ("#8b5cf6", self.t("step_users"), [(self.t("ui_sum_user"), user_info), (self.t("ui_sum_host"), self.conf['hostname'])]),
        ]
        self.lbl_sum_text.setHtml("".join(self._sum_section(c, t, r) for c, t, r in sections))

    def update_slide_ui(self):
        s = self.slides[self.current_slide_idx]
        svg_code = self.slide_svgs[self.current_slide_idx]
        try:
            renderer = QSvgRenderer(QByteArray(svg_code.encode('utf-8')))
            pm = QPixmap(300, 240)
            pm.fill(Qt.GlobalColor.transparent)
            painter = QPainter(pm)
            renderer.render(painter)
            painter.end()
            if not pm.isNull():
                self.lbl_slide_art.setPixmap(pm)
        except Exception:
            pass

        self.lbl_slide_title.setText(self.t(s["title_key"]))
        self.lbl_slide_desc.setText(self.t(s["desc_key"]))
        for i, dot in enumerate(self.slide_dots):
            if i == self.current_slide_idx:
                dot.setStyleSheet("background:#38bdf8; border-radius:4px; min-width:20px; max-width:20px; min-height:8px; max-height:8px;")
            else:
                dot.setStyleSheet("background:rgba(255,255,255,0.25); border-radius:4px; min-width:8px; max-width:8px; min-height:8px; max-height:8px;")

    def next_slide(self):
        self.current_slide_idx = (self.current_slide_idx + 1) % len(self.slides)
        self.update_slide_ui()

    def prev_slide(self):
        self.current_slide_idx = (self.current_slide_idx - 1) % len(self.slides)
        self.update_slide_ui()

