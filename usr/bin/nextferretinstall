def svg_pixmap(name, color="#ffffff", size=24, stroke=2.0):
    inner = ICONS_SVG.get(name)
    if not inner:
        return QPixmap()
    svg = ('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" '
           f'stroke="{color}" stroke-width="{stroke}" stroke-linecap="round" stroke-linejoin="round">{inner}</svg>')
    scale = 2
    pm = QPixmap(size * scale, size * scale)
    pm.fill(Qt.GlobalColor.transparent)
    painter = QPainter(pm)
    painter.setRenderHint(QPainter.RenderHint.Antialiasing)
    QSvgRenderer(QByteArray(svg.encode("utf-8"))).render(painter)
    painter.end()
    pm.setDevicePixelRatio(scale)
    return pm


def svg_icon(name, color="#ffffff", size=18, stroke=2.0):
    return QIcon(svg_pixmap(name, color, size, stroke))


def load_logo(size=100):
    for sys_path in [
        "/usr/share/icons/hicolor/4000x4000/distributor-logo.png",
        "/usr/share/icons/hicolor/scalable/apps/distributor-logo.svg",
        "/usr/share/pixmaps/arvor.png",
    ]:
        if os.path.exists(sys_path):
            pm = QPixmap(sys_path)
            if not pm.isNull():
                return pm.scaled(size, size, Qt.AspectRatioMode.KeepAspectRatio,
                                 Qt.TransformationMode.SmoothTransformation)
    try:
        renderer = QSvgRenderer(QByteArray(ARVOR_LOGO_SVG.encode("utf-8")))
        pm = QPixmap(size, size)
        pm.fill(Qt.GlobalColor.transparent)
        painter = QPainter(pm)
        renderer.render(painter)
        painter.end()
        return pm
    except Exception:
        return QPixmap()


