TRANSLATIONS_FILE = "/etc/nextferretinst/translations.json"

def load_translations():
    script_dir = os.path.dirname(os.path.abspath(__file__))
    candidates = [
        TRANSLATIONS_FILE,
        os.path.normpath(os.path.join(script_dir, "..", "..", "etc", "nextferretinst", "translations.json")),
        os.path.normpath(os.path.join(script_dir, "..", "etc", "nextferretinst", "translations.json")),
        os.path.join(os.getcwd(), "etc", "nextferretinst", "translations.json"),
        os.path.join("etc", "nextferretinst", "translations.json")
    ]
    for path in candidates:
        if os.path.exists(path):
            try:
                with open(path, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    if isinstance(data, dict) and "en" in data:
                        return data
            except Exception:
                pass
    return {"en": {"title": "Arvor Linux Installer"}}

TEXT = load_translations()


