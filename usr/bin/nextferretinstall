EXTRA_TEXT = {lg: {k: v[i] for k, v in _EXTRA_RAW.items()} for i, lg in enumerate(_LANGS)}


def tr(lang, key):
    """translations.json first, then built-in extras, then English, then the key itself."""
    for table in (TEXT.get(lang, {}), EXTRA_TEXT.get(lang, {}), TEXT.get("en", {}), EXTRA_TEXT.get("en", {})):
        if key in table:
            return table[key]
    return key


def guess_ui_lang():
    env = (os.environ.get("LC_ALL") or os.environ.get("LANG") or "").lower()
    for code in ("pt", "es", "fr", "de", "gl"):
        if env.startswith(code):
            return code
    return "en"


