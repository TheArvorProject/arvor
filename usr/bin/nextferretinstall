    def create_finish_page(self):
        w = QWidget()
        l = QVBoxLayout()
        l.setAlignment(Qt.AlignmentFlag.AlignCenter)

        badge = QLabel()
        badge.setFixedSize(120, 120)
        badge.setAlignment(Qt.AlignmentFlag.AlignCenter)
        badge.setPixmap(svg_pixmap("check", "#ffffff", 60, 2.6))
        badge.setStyleSheet("background:qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #34d399,stop:1 #059669);border-radius:60px;")

        title = QLabel(self.t("finish_msg"))
        title.setProperty("text_key", "finish_msg")
        title.setProperty("heading", "true")
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)

        sub = QLabel(self.t("finish_sub"))
        sub.setProperty("text_key", "finish_sub")
        sub.setProperty("subheading", "true")
        sub.setAlignment(Qt.AlignmentFlag.AlignCenter)
        sub.setWordWrap(True)

        hint = QLabel(self.t("ui_finish_hint"))
        hint.setProperty("text_key", "ui_finish_hint")
        hint.setAlignment(Qt.AlignmentFlag.AlignCenter)
        hint.setWordWrap(True)
        hint.setStyleSheet("font-size:13px;color:#94a3b8;margin-top:6px;")

        l.addStretch()
        l.addWidget(badge, 0, Qt.AlignmentFlag.AlignHCenter)
        l.addSpacing(30)
        l.addWidget(title)
        l.addWidget(sub)
        l.addWidget(hint)
        l.addStretch()
        w.setLayout(l)
        return w

    def validate_current_page(self):
        idx = self.stack.currentIndex()
        if idx == 1:
            self.sys_locale = self.c_locale.currentText()
            self.conf["timezone"] = self.i_tz.currentText()
        elif idx == 2:
            self.conf["keymap"] = self.c_key.currentText()
        elif idx == 3:
            self.conf["de_name"] = self.c_de.currentText()
            self.conf["de_pkgs"] = self.c_de.currentData()
            app_list = []
            if hasattr(self, 'chk_firefox') and self.chk_firefox.isChecked(): app_list.append("firefox-esr")
            if hasattr(self, 'chk_chromium') and self.chk_chromium.isChecked(): app_list.append("chromium")
            if hasattr(self, 'chk_office') and self.chk_office.isChecked(): app_list.append("libreoffice libreoffice-gtk3")
            if hasattr(self, 'chk_vlc') and self.chk_vlc.isChecked(): app_list.append("vlc")

            driver_list = []
            if hasattr(self, 'chk_nvidia') and self.chk_nvidia.isChecked(): driver_list.append("nvidia-driver")
            if hasattr(self, 'chk_firmware') and self.chk_firmware.isChecked(): driver_list.append("firmware-linux-nonfree")
            if hasattr(self, 'chk_mediatek') and self.chk_mediatek.isChecked(): driver_list.append("firmware-mediatek")

            self.conf["driver_pkgs"] = " ".join(driver_list)
            self.conf["extra_pkgs"] = " ".join(app_list + driver_list)
        elif idx == 4:
            if hasattr(self, 'c_swap'):
                self.conf["swap_mode"] = self.c_swap.currentData() or "zram"
        elif idx == 5:
            if self.c_disk.currentIndex() == -1:
                QMessageBox.warning(self, "Error", self.t("err_disk"))
                return False
            if self.disk_too_small():
                QMessageBox.warning(self, "Error", self.t("ui_disk_small").format(min=MIN_DISK_GIB))
                return False
            if self.chk_luks.isChecked() and not self.i_luks_p.text():
                QMessageBox.warning(self, "Error", self.t("err_pass"))
                return False
            self.conf["disk"] = self.c_disk.currentData()
            self.conf["luks"] = self.chk_luks.isChecked()
            self.conf["luks_pass"] = self.i_luks_p.text()
            self.conf["use_ext4"] = self.rb_ext4.isChecked()
        elif idx == 6:
            display_name = self.i_display_name.text().strip()
            user = self.i_user.text().strip()
            host = self.i_host.text().strip()
            if not user or not host:
                QMessageBox.warning(self, "Error", self.t("err_user"))
                return False
            p1, p2 = self.i_pass.text(), self.i_pass_c.text()
            if not p1 or p1 != p2:
                QMessageBox.warning(self, "Error", self.t("err_pass"))
                return False
            self.conf["display_name"] = display_name or user
            self.conf["user"] = user
            self.conf["hostname"] = host
            self.conf["pass"] = p1
        return True

    def update_progress(self, value):
        self.pbar_anim.stop()
        self.pbar_anim.setStartValue(self.pbar.value())
        self.pbar_anim.setEndValue(value)
        self.pbar_anim.start()
        idx = 0
        for i, th in enumerate(PHASE_THRESHOLDS):
            if value >= th:
                idx = i
        self.set_phase(idx)

    def set_phase(self, idx, all_done=False):
        self.current_phase = idx
        for i, chip in enumerate(self.phase_chips):
            chip.set_state("done" if (all_done or i < idx) else ("active" if i == idx else "pending"))
        if not all_done:
            self.lbl_phase.setText(self.t(PHASE_KEYS[idx]))

    def tick_elapsed(self):
        secs = int(time.time() - self.install_t0)
        self.lbl_elapsed.setText(f"{self.t('ui_elapsed')} {secs // 60:02d}:{secs % 60:02d}")

    def go_next(self):
        idx = self.stack.currentIndex()
        if not self.validate_current_page(): return

        if idx == 6:
            self.populate_summary()
        elif idx in (7, 8):
            self.start_install()
            return
        elif idx == 9:
            if not SIMULATE:
                Sys.run("reboot")
            sys.exit(0)

        self.goto_page(idx + 1)

    def go_back(self):
        idx = self.stack.currentIndex()
        if 0 < idx < 9:
            self.goto_page(idx - 1)

    def goto_page(self, new_idx):
        self.nav_container.setEnabled(False)
        self.overlay.begin()
        def finish():
            self.stack.setCurrentIndex(new_idx)
            self.refresh_nav()
            self.overlay.end()
            self.nav_container.setEnabled(True)
        QTimer.singleShot(380, finish)

    def on_log_msg(self, msg):
        if hasattr(self, 'lbl_status') and msg:
            line = msg.strip().split('\n')[-1]
            if len(line) > 90:
                line = line[:87] + "..."
            self.lbl_status.setText(line)

    def start_install(self):
        self.stack.setCurrentIndex(8)
        self.update_sidebar()
        self.nav_container.hide()

        self.txt_log.clear()
        self.txt_log.hide()
        self.slide_card.show()
        self.btn_toggle_log.setText(self.t("view_log"))
        self.pbar_anim.stop()
        self.pbar.setValue(0)
        self.lbl_status.setText(self.t("installing_prep"))
        self.lbl_phase.setStyleSheet("font-size:18px;font-weight:700;color:#172033;")
        self.lbl_wait.show()
        self.install_ok.hide()
        self.install_spinner.show()
        self.install_spinner.start()
        self.set_phase(0)
        self.install_t0 = time.time()
        self.tick_elapsed()
        self.elapsed_timer.start(1000)
        if hasattr(self, 'slide_timer'):
            self.slide_timer.start(5000)

        self.worker = InstallWorker(self.conf, self.sys_locale)
        self.worker.log_msg.connect(self.txt_log.append)
        self.worker.log_msg.connect(self.on_log_msg)
        self.worker.progress.connect(self.update_progress)
        self.worker.finished.connect(self.install_done)
        self.worker.start()

    def install_done(self, success):
        if hasattr(self, 'slide_timer'):
            self.slide_timer.stop()
        self.elapsed_timer.stop()
        self.install_spinner.stop()
        self.install_spinner.hide()
        self.pbar_anim.stop()

        if success:
            self.pbar.setValue(100)
            self.set_phase(4, all_done=True)
            self.stack.setCurrentIndex(9)
            self.nav_container.show()
            self.refresh_nav()
        else:
            self.slide_card.hide()
            self.phase_chips[getattr(self, "current_phase", 0)].set_state("failed")
            self.install_ok.setPixmap(svg_pixmap("x-circle", "#dc2626", 30, 2))
            self.install_ok.show()
            self.lbl_phase.setText(self.t("ui_failed"))
            self.lbl_phase.setStyleSheet("font-size:18px;font-weight:700;color:#b02b2b;")
            self.lbl_status.setText(self.t("ui_failed_hint"))
            self.lbl_wait.hide()
            self.txt_log.show()
            self.btn_toggle_log.setText(self.t("hide_log"))
            self.nav_container.show()
            self.refresh_nav()

    def apply_styles(self):
        self.setStyleSheet(STYLES)


if __name__ == "__main__":
    app = QApplication(sys.argv)
    app.setStyle("Fusion")
    base_font = QFont()
    base_font.setFamilies(["Inter", "Noto Sans", "Cantarell", "Ubuntu", "DejaVu Sans", "Segoe UI", "Sans Serif"])
    app.setFont(base_font)

    if hasattr(os, "geteuid") and os.geteuid() != 0 and not SIMULATE:
        QMessageBox.critical(None, "Error", "Must run as root.")
        sys.exit(1)

    if not SIMULATE:
        for tool in ["debootstrap", "mkfs.xfs", "mkfs.ext4", "pvcreate", "vgcreate", "lvcreate", "parted", "cryptsetup", "wipefs", "mkfs.vfat", "wget", "efibootmgr"]:
            if not shutil.which(tool):
                QMessageBox.critical(None, "Error", f"Missing tool: {tool}")
                sys.exit(1)

    gui = InstallerGUI()
    gui.apply_styles()
    gui.showMaximized()
    gui.raise_()
    gui.activateWindow()

    net_worker = NetCheckWorker()
    gui.net_worker = net_worker

    def on_net(ok):
        if not ok:
            QMessageBox.critical(gui, "Network Error", TEXT.get("en", {}).get("net_err", "No network connection."))
            app.exit(1)

    net_worker.result.connect(on_net)
    net_worker.start()
    sys.exit(app.exec())
