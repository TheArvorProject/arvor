    @staticmethod
    def parse_size(text):
        units = {"K": 1 << 10, "M": 1 << 20, "G": 1 << 30, "T": 1 << 40, "P": 1 << 50}
        s = str(text or "").strip().replace(",", ".")
        try:
            if s and s[-1].upper() in units:
                return int(float(s[:-1]) * units[s[-1].upper()])
            return int(float(s))
        except ValueError:
            return 0

    @staticmethod
    def fmt_size(b):
        for unit, div in (("TiB", 1 << 40), ("GiB", 1 << 30), ("MiB", 1 << 20)):
            if b >= div:
                v = b / div
                return f"{v:.1f} {unit}" if v < 100 else f"{v:.0f} {unit}"
        return f"{b} B"

    def selected_disk_bytes(self):
        idx = self.c_disk.currentIndex()
        if 0 <= idx < len(self.disks_info):
            return self.parse_size(self.disks_info[idx].get("size"))
        return 0

    def disk_too_small(self):
        return self.selected_disk_bytes() < MIN_DISK_GIB * (1 << 30)

    def _make_disk_cards(self):
        box = QVBoxLayout()
        box.setSpacing(10)
        self.disk_cards = []
        for i, d in enumerate(self.disks_info):
            card = QFrame()
            card.setObjectName("disk_card")
            card.setCursor(Qt.CursorShape.PointingHandCursor)
            h = QHBoxLayout(card)
            h.setContentsMargins(16, 12, 16, 12)
            h.setSpacing(14)
            ic = QLabel()
            ic.setFixedSize(42, 42)
            ic.setAlignment(Qt.AlignmentFlag.AlignCenter)
            v = QVBoxLayout()
            v.setSpacing(2)
            nm = QLabel(d.get("model") or "Disk")
            nm.setStyleSheet("font-size:14px;font-weight:700;color:#1e293b;background:transparent;border:none;")
            sub = QLabel(f"/dev/{d['name']}")
            sub.setStyleSheet("font-size:12px;color:#64748b;background:transparent;border:none;")
            v.addWidget(nm)
            v.addWidget(sub)
            sz = QLabel(self.fmt_size(self.parse_size(d.get("size"))))
            sz.setStyleSheet("font-size:16px;font-weight:700;color:#4a78ff;background:transparent;border:none;")
            h.addWidget(ic)
            h.addLayout(v, 1)
            h.addWidget(sz)
            card.mousePressEvent = lambda e, idx=i: self.c_disk.setCurrentIndex(idx)
            self.disk_cards.append((card, ic))
            box.addWidget(card)
        if not self.disks_info:
            empty = QLabel(self.t("ui_disk_none"))
            empty.setProperty("text_key", "ui_disk_none")
            empty.setStyleSheet("color:#b02b2b;font-weight:700;")
            box.addWidget(empty)
        self.c_disk.currentIndexChanged.connect(self.refresh_disk_cards)
        self.refresh_disk_cards()
        return box

    def refresh_disk_cards(self, *_):
        cur = self.c_disk.currentIndex()
        for i, (card, ic) in enumerate(self.disk_cards):
            if i == cur:
                card.setStyleSheet("QFrame#disk_card{background:#f0f5ff;border:2px solid #4a78ff;border-radius:14px;}")
                ic.setStyleSheet("background:#4a78ff;border-radius:12px;border:none;")
                ic.setPixmap(svg_pixmap("hard-drive", "#ffffff", 22, 2))
            else:
                card.setStyleSheet("QFrame#disk_card{background:#ffffff;border:1.5px solid #d9e1eb;border-radius:14px;}"
                                   "QFrame#disk_card:hover{border-color:#4a78ff;}")
                ic.setStyleSheet("background:#eaf0ff;border-radius:12px;border:none;")
                ic.setPixmap(svg_pixmap("hard-drive", "#4a78ff", 22, 2))

    def update_disk_preview(self, *_):
        """Recalculate the layout from the selected disk and filesystem (same proportions the installer really uses)."""
        if not hasattr(self, 'preview_rows') or not hasattr(self, 'rb_ext4'):
            return
        total = self.selected_disk_bytes()
        idx = self.c_disk.currentIndex()
        esp, boot = 512 << 20, 1024 << 20
        rest = max(0, total - esp - boot)
        root = int(rest * 0.78)
        snap = rest - root
        sizes = [esp + boot, root, snap]
        fs = "ext4" if self.rb_ext4.isChecked() else "XFS"
        enc = " · LUKS" if getattr(self, "chk_luks", None) is not None and self.chk_luks.isChecked() else ""
        valid = 0 <= idx < len(self.disks_info) and total > 0

        if hasattr(self, 'btn_adv'):
            self.btn_adv.setText(self.t("ui_advanced"))
        if valid:
            d = self.disks_info[idx]
            label = f"/dev/{d['name']} ({d.get('model') or 'Disk'}, {self.fmt_size(total)})"
            self.lbl_disk_legend.setText(f"/dev/{d['name']} · {d.get('model') or 'Disk'} · {self.fmt_size(total)} · GPT")
            if getattr(self, 'lbl_disk_warn', None):
                self.lbl_disk_warn.setText(self.t("ui_disk_erase").format(disk=label))
            weights = [max(s_, total * 0.06) for s_ in sizes]
        else:
            self.lbl_disk_legend.setText("")
            if getattr(self, 'lbl_disk_warn', None):
                self.lbl_disk_warn.setText(self.t("disk_warn"))
            weights = [1, 1, 1]
        tot_w = sum(weights) or 1
        pct = [s_ / total * 100 if total else 0 for s_ in sizes]
        names = [self.t("ui_part_bootfiles"), self.t("ui_part_root"), self.t("ui_part_snap")]
        for i, seg in enumerate(self.seg_labels):
            self.bar_layout.setStretch(i, max(1, int(weights[i] / tot_w * 1000)))
            seg.setText(f"{self.fmt_size(sizes[i])}" if total else "")
            seg.setToolTip(f"{names[i]} · {pct[i]:.0f}%")
        details = [
            "EFI (FAT32) + /boot (ext4)",
            f"{fs} · /  (LVM thin){enc}",
            self.t("ui_part_snap_d"),
        ]
        for i, (name, detail, size) in enumerate(self.preview_rows):
            name.setText(names[i])
            detail.setText(details[i])
            size.setText(f"{self.fmt_size(sizes[i])}  ({'<1' if 0 < pct[i] < 1 else format(pct[i], '.0f')}%)" if total else "—")

        if hasattr(self, 'lbl_disk_small'):
            if total and self.disk_too_small():
                self.lbl_disk_small.setText(self.t("ui_disk_small").format(min=MIN_DISK_GIB))
                self.lbl_disk_small.show()
            else:
                self.lbl_disk_small.hide()

    def slugify_username(self, name):
        import unicodedata, re
        n = unicodedata.normalize('NFKD', name).encode('ASCII', 'ignore').decode('utf-8')
        n = n.lower().strip()
        n = re.sub(r'[\s_]+', '-', n)
        n = re.sub(r'[^a-z0-9-]', '', n)
        n = re.sub(r'^[^a-z]+', '', n)
        return n[:32]

    def on_display_name_changed(self, text):
        if not self.user_manually_edited:
            slugified = self.slugify_username(text)
            self.i_user.setText(slugified)

    def on_username_edited(self, text):
        self.user_manually_edited = True

