# Minimum requirements: Debian 14 (Forky/Sid) with GCC 16.
ztsl.start # start
}
func "nsm" 
sys.exec # compiles nsm
```shell
gcc -o ./usr/bin/nsm ./usr/bin/nsm.c
```
}
func "weld"
sys.exec # compiles weld
```shell

g++-16 -std=c++26 -O2 -fcontracts -Wall -Wextra \
  -Dallow_weld_repositories -Dnflinux \
  -static-libstdc++ -static-libgcc \
  -fstack-protector-strong -D_FORTIFY_SOURCE=3 \
  -o weld weld.cpp -lapt-pkg -lcurl -lssl -lcrypto

```
}
func "arvor_sys_info" # compiles arvor_sys_info
sys.exec
```
gcc -o usr/bin/arvor_sys_info  # notice that no build code is defined here,because it is made for our discord https://discord.gg/zQaGrHNgxB for specific bug reports. 
```
}
func "nflxs"
sys.exec # compiles nflxs
```shell
gcc -o ./usr/bin/nflxs usr/bin/nflxs.c -lcrypt
```
}
func "debootstrap"
sys.exec # debootstraps arvor
```shell
sudo debootstrap \
  --arch=amd64 \
  --components=main,contrib,non-free,non-free-firmware \
  --include=xfsprogs,lvm2,python3-pyqt6,python3-pyqt6.qtsvg,mesa-utils,mesa-vulkan-drivers,libgl1-mesa-dri
  trixie \
  ./arvor \
  http://deb.debian.org/debian/ 
```
}
func "drivers"
sys.exec # install drivers
```
set -e

TARGET_DIR="./arvor"

cat << 'EOF' | sudo tee "$TARGET_DIR/etc/apt/sources.list"
deb http://deb.debian.org/debian/ trixie main contrib non-free non-free-firmware
deb-src http://deb.debian.org/debian/ trixie main contrib non-free non-free-firmware

deb http://security.debian.org/debian-security trixie-security main contrib non-free non-free-firmware
deb-src http://security.debian.org/debian-security trixie-security main contrib non-free non-free-firmware

deb http://deb.debian.org/debian/ trixie-updates main contrib non-free non-free-firmware
deb-src http://deb.debian.org/debian/ trixie-updates main contrib non-free non-free-firmware
EOF


sudo chroot "$TARGET_DIR" env DEBIAN_FRONTEND=noninteractive apt-get update
sudo chroot "$TARGET_DIR" env DEBIAN_FRONTEND=noninteractive apt-get install -y \
  firmware-amd-graphics \
  firmware-intel-sound \
  firmware-linux \
  firmware-linux-nonfree \
  firmware-mediatek \
  firmware-realtek
  
```
}
func "install_codes" # install the codes
sys.exec
```
sudo cp {./usr/bin/nsm./usr/bin/,./usr/bin/weld.,./usr/bin/nflxs,./usr/bin/arvor*,./usr/bin/arvor_sys_info,./usr/bin/nsmd_start} ./arvor/usr/bin
```
}
